<Window x:Class="MyAutoBadge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MyAutoBadge"
        Height="450"
        Width="450">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Badgeage Auto"
                       FontSize="24"
                       FontWeight="Bold"
                       Margin="0,0,0,10"/>
            <!-- version automatique -->
            <StackPanel Name="AutoBadgeButton"
                        Orientation="Horizontal"
                        Margin="0,0,0,10">
                <Ellipse Width="12"
                         Height="12"
                         Fill="Green"
                         Margin="0,3,8,0"/>
                <TextBlock Name="AutoBadgeInfo"
                           FontSize="14"
                           VerticalAlignment="Center"/>
            </StackPanel>
            <!-- version manuelle -->
            <Button Name="ManualBadgeButton"
                    Content="Badger maintenant"
                    Click="ManualBadgeButton_Click"
                    Height="40"
                    Margin="0,0,0,10"/>
            <TextBlock Name="HolidayInfo"
                       FontSize="13"
                       Foreground="DarkOrange"
                       Margin="0,0,0,10"/>
            <TextBlock Name="ManualBadgeStatus"
                       FontSize="13"
                       Foreground="DarkRed"
                       Margin="0,0,0,10"/>
            <Button Name="StopButton"
                    Content="Arrêter"
                    Click="StopButton_Click"
                    Height="40"
                    Margin="0,0,0,10"/>
            <TextBlock Text="Logs récents :"
                       FontWeight="Bold"
                       Margin="0,20,0,5"/>
            <TextBox Name="LogBox"
                     Height="150"
                     IsReadOnly="True"
                     VerticalScrollBarVisibility="Auto"
                     TextWrapping="Wrap"/>
        </StackPanel>
    </Grid>
</Window>